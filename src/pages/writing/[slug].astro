---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — ${site.name}`} description={post.data.title}>
  <header>
    <div class="container">
      <div class="header-inner">
        <a href="/" class="site-name">{site.name}</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <div class="container">
      <article class="post-article">
        <header class="post-header">
          <p class="post-meta">
            <span class="post-date">{post.data.date}</span>
            <span class="sep" aria-hidden="true">·</span>
            <span class="post-read">{post.data.readingTime}</span>
          </p>
          <h1 class="post-title">{post.data.title}</h1>
        </header>
        <div class="post-body">
          <Content />
        </div>
        <footer class="post-footer">
          <a href="/writing" class="back-link">← All writing</a>
        </footer>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  header {
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    padding: 28px 0;
  }
  .site-name {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--ink);
    text-decoration: none;
  }
  .post-article {
    max-width: 680px;
    padding: clamp(56px, 8vw, 100px) 0;
  }
  .post-header {
    margin-bottom: 48px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 40px;
  }
  .post-meta {
    display: flex;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .post-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  /* Post body prose styles */
  .post-body {
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink);
  }
  .post-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
    margin: 2.5em 0 0.75em;
  }
  .post-body :global(h3) {
    font-size: 20px;
    font-weight: 600;
    margin: 2em 0 0.5em;
  }
  .post-body :global(p) {
    margin: 0 0 1.5em;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.5em;
  }
  .post-body :global(li) {
    margin-bottom: 0.4em;
  }
  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .post-body :global(a:hover) {
    color: var(--accent);
  }
  .post-body :global(pre) {
    background: var(--ink);
    color: var(--paper);
    padding: 24px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 1.5em;
  }
  .post-body :global(code) {
    font-family: var(--font-body);
    font-size: 0.9em;
  }
  .post-body :global(pre code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 14px;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--rule);
    margin: 0 0 1.5em;
    padding: 0 0 0 24px;
    color: var(--muted);
  }
  .post-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }
  .back-link {
    font-size: 16px;
    font-weight: 500;
    padding: 12px 0;
    display: inline-block;
  }
</style>
