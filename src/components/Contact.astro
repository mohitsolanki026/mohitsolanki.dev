---
import { site } from '../data/site';
---

<section id="contact" aria-labelledby="contact-label" style="background: var(--ink); color: var(--on-dark);" class="">
  <div class="contact-inner container">
    <p class="label contact-label" id="contac</div>t-label">04 — Contact</p>
    <h2 id="contact-heading" class="contact-heading">
      Let's make something <em style="font-style:italic">together.</em>
    </h2>
    <a href={`mailto:${site.contact.email}`} class="contact-email">{site.contact.email}</a>
    
    <div class="contact-socials">
      {site.socials.map(s => (
        <a href={s.href} rel="noopener noreferrer" target="_blank" class="social-link">{s.label}</a>
      ))}
    </div>

    <div class="contact-bottom">
      <span>© 2026 {site.name}</span>
      <a href="#top" class="back-top">Back to top ↑</a>
    </div>
  </div>
</section>

<style>
  section {
    width: 100%;
  }
  .contact-inner {
    padding: clamp(72px, 10vw, 140px) clamp(20px, 5vw, 64px) 48px clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .contact-inner a:focus-visible {
    outline-color: var(--on-dark);
  }
  .contact-label {
    color: var(--muted-on-dark);
    margin: 0;
  }
  .contact-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 8vw, 112px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .contact-email {
    color: var(--on-dark);
    font-size: clamp(22px, 3vw, 34px);
    text-decoration: underline;
    text-underline-offset: 6px;
    align-self: flex-start;
  }
  .contact-email:hover {
    color: var(--muted-on-dark);
  }
  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
  .social-link {
    font-size: 16px;
    font-weight: 500;
    padding: 12px 0;
    color: var(--on-dark);
    text-decoration: none;
  }
  .social-link:hover {
    color: var(--muted-on-dark);
  }
  .contact-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    border-top: 1px solid var(--rule-on-dark);
    padding-top: 24px;
    margin-top: 40px;
    font-size: 14px;
    color: var(--muted-on-dark);
  }
  .back-top {
    color: var(--muted-on-dark);
    text-decoration: none;
  }
  .back-top:hover {
    color: var(--on-dark);
  }
</style>
