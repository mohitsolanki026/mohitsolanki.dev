---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('writing')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const posts = allPosts.slice(0, 3);
---

<section id="writing" aria-labelledby="writing-label" class="section-shell">
  <div class="container">
    <div class="section-inner">
      <div class="section-left">
        <span class="label" id="writing-label">03 — Writing</span>
      </div>
      <div class="section-right">
        <!-- <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.slug}`} class="post-row">
                <span class="post-date">{p.data.date}</span>
                <span class="post-title">{p.data.title}</span>
                <span class="post-read">{p.data.readingTime}</span>
                <span class="post-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul> -->
        <!-- <a href="/writing" class="all-writing">All writing →</a> -->
        <p>I’ll start sharing useful tips soon. Stay tuned!</p>        
      </div>
    </div>
  </div>
</section>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  li:last-child .post-row {
    border-bottom: 1px solid var(--rule);
  }
  .post-date {
    width: 110px;
    font-size: 15px;
    color: var(--muted);
    flex-shrink: 0;
  }
  .post-title {
    flex: 1 1 280px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    transition: color 0.2s;
  }
  .post-read {
    font-size: 15px;
    color: var(--muted);
  }
  .post-arrow {
    font-size: 20px;
    transition: transform 0.2s ease;
  }
  .post-row:hover .post-title {
    color: var(--accent);
  }
  .post-row:hover .post-arrow {
    transform: translateX(6px);
  }
  .all-writing {
    font-size: 16px;
    font-weight: 500;
    padding: 12px 0;
    display: inline-block;
    margin-top: 28px;
  }
</style>
