---
import { site } from '../data/site';
---

<header>
  <div class="container">
    <div class="header-inner">
      <a href="#top" class="site-name">{site.name}</a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#work">Work</a></li>
          <li><a href="#writing">Writing</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding: 28px 0;
  }
  .site-name {
    font-family: var(--font-display);
    font-size: 26px;
    text-decoration: none;
    color: var(--ink);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
  }
  nav a {
    padding: 10px 14px;
    font-size: 15px;
    font-weight: 500;
  }
</style>
