---
import { site } from '../data/site';
---

<section id="about" aria-labelledby="about-label" class="section-shell">
  <div class="container">
    <div class="section-inner">
      <div class="section-left">
        <span class="label" id="about-label">01 — About</span>
      </div>
      <div class="section-right">
        <p class="about-statement">{site.about.statement}</p>
        <div class="facts-grid">
          {site.about.facts.map((fact) => (
            <div class="fact">
              <span class="fact-label">{fact.label}</span>
              <span class="fact-value">{fact.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-right {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .about-statement {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.2;
    margin: 0;
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  @media (max-width: 600px) {
    .facts-grid {
      grid-template-columns: 1fr;
    }
  }
  .fact-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .fact-value {
    display: block;
  }
</style>
